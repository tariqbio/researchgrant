# ── Copy this file to .env for local development ──────────────────────────────

# App
ENVIRONMENT=development
SECRET_KEY=your-random-secret-key-here

# Database (Railway injects DATABASE_URL automatically when you add a Postgres plugin)
DATABASE_URL=postgresql://postgres:password@localhost:5432/grantbd

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Google Vision OCR (https://console.cloud.google.com)
# Option A: path to service account JSON file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Option B: base64-encoded JSON (production / Railway)
# GOOGLE_VISION_CREDENTIALS=eyJ0eXBlIjoic2...

# SendGrid email (https://sendgrid.com — free tier: 100 emails/day)
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=alerts@yourdomain.com
SENDGRID_FROM_NAME=GrantBD

# Storage (local for dev — switch to s3 in production)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/tmp/grantbd_uploads

# CORS (comma-separated list of allowed origins)
# In production: set to your Railway app URL, e.g. https://grantbd-production.up.railway.app
ALLOWED_ORIGINS=["http://localhost:5173"]

# Admin seed (run once after deploy: python -m app.core.seed_admin)
ADMIN_EMAIL=admin@grantbd.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=GrantBD Admin
